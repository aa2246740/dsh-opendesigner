{
  "name": "dsh-opendesigner",
  "version": "0.2.0",
  "description": "DeepSeek Harness plugin: local-first visual React/Tailwind designer with a jailed tool surface.",
  "type": "module",
  "main": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
  "exports": {
    "\u002e": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./lib/client.js",
      "default": "./lib/client.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib/client.js",
    "cordis.patch.yml",
    "preview.html",
    "preview/app.js",
    "README.md",
    "LICENSE",
    "docs/SHIPPED.md"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/bundle-client.mjs",
    "dev": "tsc -w",
    "test": "node --experimental-strip-types --test --test-reporter=spec test/*.ts",
    "test:review": "REVIEW_SOURCE_ROOT=$PWD/src node --experimental-strip-types --test --test-reporter=spec docs/review-2026-09-07/qa/*.test.mjs",
    "test:review:pr3": "REVIEW_SOURCE_ROOT=$PWD/src node --experimental-strip-types --test --test-reporter=spec docs/review-pr3/qa/*.test.mjs",
    "test:review:pr4": "REVIEW_SOURCE_ROOT=$PWD/src node --experimental-strip-types --test --test-reporter=spec docs/review-pr4/qa/*.test.mjs",
    "test:review:pr4r2": "REVIEW_SOURCE_ROOT=$PWD/src node --experimental-strip-types --test --test-reporter=spec docs/review-pr4-r2/qa/*.test.mjs",
    "preview": "node --experimental-strip-types scripts/preview-server.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "visual-editor",
    "react",
    "tailwind",
    "cordis"
  ],
  "author": "OpenDesigner Community",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aa2246740/dsh-opendesigner.git"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "plugin": {
      "displayName": "OpenDesigner",
      "summary": {
        "en": "Jailed local-first visual designer plugin for DeepSeek Harness.",
        "zh-CN": "DeepSeek Harness \u672c\u5730\u4f18\u5148\u89c6\u89c9\u8bbe\u8ba1\u5668\u63d2\u4ef6\uff0c\u6587\u4ef6\u5de5\u5177\u9650\u5236\u5728\u5de5\u7a0b\u6839\u76ee\u5f55\u5185\u3002"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-code-runtime": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-scope": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.1.5-rc.2",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "@babel/types": "^7.26.0"
  }
}
